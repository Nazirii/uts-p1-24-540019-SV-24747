# Salin menjadi .env lalu isi nilainya:  cp .env.example .env
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).

# Buat APP_KEY dengan:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

DB_DATABASE=agenda
DB_USERNAME=agenda
DB_PASSWORD=ganti_password_ini
DB_ROOT_PASSWORD=ganti_root_password_ini
